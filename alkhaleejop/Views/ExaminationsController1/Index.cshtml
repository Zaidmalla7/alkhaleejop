@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/responsive.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        var examsTable;

        function toggleSign(inputId, sign) {
        var input = document.getElementById(inputId);
        if (!input) return;
        var val = input.value.replace(/\+/g, '').replace(/\-/g, '');
        input.value = sign + val;
        input.focus();
        }

        function setSmartDate(months) {
        let today = new Date();
        let currentDay = today.getDate();
        let targetMonth = today.getMonth() + months;
        let d = new Date(today.getFullYear(), targetMonth, currentDay);
        if (d.getMonth() !== targetMonth % 12 && targetMonth % 12 !== -1) { d.setDate(0); }
        let yyyy = d.getFullYear();
        let mm = String(d.getMonth() + 1).padStart(2, '0');
        let dd = String(d.getDate()).padStart(2, '0');
        $('#NextExamDate').val(`${yyyy}-${mm}-${dd}`);
        $('#NextExamDate').removeClass('is-invalid').addClass('is-valid');
        }

        function previewFileName(input) {
        const textSpan = $('#uploadText span'); const icon = $('#uploadText i'); const wrapper = $('#uploadWrapper');
        if (input.files && input.files[0]) {
        textSpan.text(input.files[0].name);
        icon.removeClass('fa-camera text-muted').addClass('fa-image text-primary');
        wrapper.css('border-color', 'var(--brand-color)');
        } else {
        textSpan.text('التقط أو ارفع صورة');
        icon.removeClass('fa-image text-primary').addClass('fa-camera text-muted');
        wrapper.css('border-color', '#cbd5e1');
        }
        }

        function resetUploadBox() {
        $('#ImageFile').val('');
        $('#uploadText span').text('التقط أو ارفع صورة');
        $('#uploadText i').removeClass('fa-image text-primary fa-check text-success').addClass('fa-camera text-muted');
        $('#uploadWrapper').css('border-color', '#cbd5e1');
        }

        function generateWaLink(phone, message) {
        if (!phone) return '#';
        let pStr = phone.replace(/\D/g, '');
        if (pStr.startsWith('07') && pStr.length === 10) { pStr = '962' + pStr.substring(1); }
        else if (pStr.startsWith('7') && pStr.length === 9) { pStr = '962' + pStr; }
        else if (pStr.startsWith('00962')) { pStr = pStr.substring(2); }
        return `https://wa.me/${pStr}?text=${message}`;
        }

        function viewImage(examId) {
        Swal.fire({ title: 'جاري جلب الصورة...', allowOutsideClick: false, didOpen: () => { Swal.showLoading() } });
        $.get('/ExaminationsController1/GetExamById', { id: examId })
        .done(function (res) {
        Swal.close();
        if (res.success && res.data.glassImagePath) {
        $('#examImageDisplay').attr('src', res.data.glassImagePath);
        $('#imageModal').modal('show');
        } else { Swal.fire('تنبيه', 'لا يوجد صورة مرفقة مع هذا الفحص.', 'info'); }
        }).fail(function() { Swal.fire('خطأ!', 'فصل الاتصال بالسيرفر.', 'error'); });
        }

        $(document).ready(function () {

        $('#examForm').on('keydown', 'input:not([type="hidden"]):not([type="file"]), select, textarea', function(e) {
        if (e.key === 'Enter') {
        if($(this).is('textarea')) return;
        e.preventDefault();

        var currentTabIndex = parseInt($(this).attr('tabindex'));
        if (!isNaN(currentTabIndex)) {
        var nextElement = $('[tabindex="' + (currentTabIndex + 1) + '"]');
        if (nextElement.length) {
        nextElement.focus();
        } else {
        $('#btnSaveExam').focus();
        }
        }
        }
        });

        $('#quickPatientForm').on('keydown', 'input', function(e) {
        if (e.key === 'Enter') {
        e.preventDefault();
        var inputs = $('#quickPatientForm').find('input:not([type="hidden"])');
        var index = inputs.index(this);
        if (index > -1 && index < inputs.length - 1) { inputs.eq(index + 1).focus(); }
        else if (index === inputs.length - 1) { saveQuickPatient(); }
        }
        });

        $('#PatientId').select2({
        dropdownParent: $('#examModal'),
        placeholder: "اضغط للبحث عن اسم المريض أو رقمه...",
        allowClear: true,
        language: { noResults: function () { return "لا يوجد نتائج، يرجى التأكد من الاسم أو الرقم"; }, searching: function () { return "جاري البحث بالداتا بيس..."; } },
        ajax: {
        url: '/ExaminationsController1/SearchPatients', dataType: 'json', delay: 250,
        data: function (params) { return { term: params.term }; },
        processResults: function (data) { return { results: data }; }
        }
        });

        examsTable = $('#examsTable').DataTable({
        ajax: { url: '/ExaminationsController1/GetExamsData', type: 'GET', datatype: 'json' },
        dom: '<"top-controls-wrapper"<"left-controls d-flex align-items-center gap-4"lB>f>rt<"row align-items-center mt-3"<"col-md-6"i><"col-md-6"p>>',
        buttons: [
        { extend: 'excelHtml5', text: '<i class="fa-solid fa-file-excel text-success"></i> إكسيل', className: 'btn', exportOptions: { columns: [0, 1, 2, 3], orthogonal: 'export' } },
        { extend: 'print', text: '<i class="fa-solid fa-print text-secondary"></i> طباعة القائمة', className: 'btn', exportOptions: { columns: [0, 1, 2, 3], orthogonal: 'export' }, customize: function (win) { $(win.document.body).css('direction', 'rtl').css('text-align', 'right'); $(win.document.body).find('table').addClass('table-bordered').css('font-size', '14pt'); } }
        ],
        columns: [
        {
        data: 'examDate', responsivePriority: 2,
        render: function(data, type, row) {
        var date = new Date(data);
        if(type === 'display') {
        return `<div class="d-flex flex-column"><span class="fw-bold text-dark">${date.toLocaleDateString('ar-JO')}</span><span class="text-muted small"><i class="fa-regular fa-clock"></i> ${date.toLocaleTimeString('ar-JO', {hour: '2-digit', minute:'2-digit'})}</span></div>`;
        }
        return date.toLocaleDateString('ar-JO') + " - " + date.toLocaleTimeString('ar-JO', {hour: '2-digit', minute:'2-digit'});
        }
        },
        { data: 'patientName', responsivePriority: 1, render: function(data, type, row) { if(type === 'display') return `<span class="fw-bold" style="color: var(--brand-color); font-size: 1.05rem;">${data}</span>`; return data; } },
        {
        data: 'phoneNumber', responsivePriority: 4,
        render: function(data, type, row) {
        if(type === 'display') {
        let primaryPhone = `<div class="fw-bold text-dark" style="direction:ltr; text-align: right;">${data}</div>`;
        let secondaryPhone = '';
        if(row.secondaryPhoneNumber) {
        let noteBadge = row.secondaryPhoneOwner ? `<span class="badge bg-light text-secondary border ms-2 px-2 py-1">${row.secondaryPhoneOwner}</span>` : '';
        secondaryPhone = `<div class="mt-1 d-flex align-items-center justify-content-end flex-wrap gap-1" style="font-size: 0.85rem;">${noteBadge}<span class="text-muted" style="direction:ltr;"><i class="fa-solid fa-phone-arrow-up-right fa-xs me-1"></i>${row.secondaryPhoneNumber}</span></div>`;
        }
        return primaryPhone + secondaryPhone;
        }
        let plainText = data ? data + " " : "";
        if(row.secondaryPhoneNumber) {
        let note = row.secondaryPhoneOwner ? ` (${row.secondaryPhoneOwner})` : '';
        plainText += ` | احتياطي: ${row.secondaryPhoneNumber}${note}`;
        }
        return plainText;
        }
        },
        {
        data: 'nextExamDate', responsivePriority: 5,
        render: function(data, type, row) {
        if(!data) return type === 'display' ? '<span class="text-muted">-</span>' : 'لا يوجد موعد';
        var d = new Date(data);
        if(type === 'display') {
        var today = new Date(); today.setHours(0,0,0,0);
        var badgeClass = d < today ? 'bg-danger text-white' : (d.getTime() === today.getTime() ? 'bg-warning text-dark' : 'bg-success text-white');
        var reminderBadge = '';
        if(row.isReminderSent) { reminderBadge = `<div class="mt-1"><span class="badge bg-success" style="font-size: 0.75rem;"><i class="fa-solid fa-check-double me-1"></i>تم التذكير</span></div>`; }
        else if(d <= new Date(today.getTime() + (14 * 24 * 60 * 60 * 1000))) { reminderBadge = `<div class="mt-1"><span class="badge bg-secondary" style="font-size: 0.75rem;"><i class="fa-regular fa-clock me-1"></i>بانتظار التواصل</span></div>`; }
        return `<div class="d-flex flex-column align-items-start"><span class="badge ${badgeClass} px-2 py-1 mb-1" style="font-size: 0.85rem;"><i class="fa-regular fa-calendar-check me-1"></i> ${d.toLocaleDateString('ar-JO')}</span>${reminderBadge}</div>`;
        }
        let excelText = d.toLocaleDateString('ar-JO');
        if(row.isReminderSent) excelText += " (تم التواصل)";
        return excelText;
        }
        },
        {
        data: 'id', orderable: false, responsivePriority: 3,
        render: function (data, type, row) {
        var safeName = encodeURIComponent(row.patientName || '');
        var phone = row.phoneNumber || '';
        var imgBtn = row.hasImage ? `<button class="btn-action btn-image" onclick="viewImage(${data})" title="عرض صورة النظارة"><i class="fa-regular fa-image"></i></button>` : ``;
        return `<div class="actions-wrapper">${imgBtn}<button class="btn-action btn-contact" onclick="openContactModal(${data})" title="تواصل وتذكير"><i class="fa-brands fa-whatsapp"></i></button><button class="btn-action btn-view" onclick="printExam(${data}, '${safeName}', '${phone}')" title="معاينة وطباعة الوصفة"><i class="fa-solid fa-print"></i></button><button class="btn-action btn-edit" onclick="editExam(${data}, '${safeName}')" title="تعديل الفحص"><i class="fa-solid fa-pen"></i></button><button class="btn-action btn-delete" onclick="deleteExam(${data})" title="حذف الفحص"><i class="fa-solid fa-trash"></i></button></div>`;
        }
        }
        ],
        language: { url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/ar.json' },
        ordering: false, responsive: true
        });
        });

        function openContactModal(examId) {
        Swal.fire({ title: 'جاري جلب البيانات...', allowOutsideClick: false, didOpen: () => { Swal.showLoading() } });

        $.get('/ExaminationsController1/GetContactInfo', { id: examId })
        .done(function (res) {
        Swal.close();
        if (res.success) {
        var d = res.data;
        $('#contactPatientName').text(d.patientName);
        $('#contactExamDate').html(`<i class="fa-regular fa-calendar-check me-1"></i> الموعد القادم: ${d.nextExamDateStr}`);

        // دالة داخلية لتحديث روابط الواتساب بناءً على نوع الرسالة المختارة
        function updateLinks() {
        var msgType = $('input[name="msgType"]:checked').val();
        var waMsg = "";

        // تحديد النص بناءً على الخيار
        if (msgType === 'reminder') {
        waMsg = encodeURIComponent(`مرحباً أستاذ ${d.patientName}، معك الخليج للبصريات. نود تذكيرك بأن موعد فحصك الدوري المجاني قد حان بتاريخ ${d.nextExamDateStr}. نتشرف بزيارتك! 👓`);
        } else if (msgType === 'welcome') {
        waMsg = encodeURIComponent(`مرحباً أستاذ ${d.patientName}، أهلاً بك في الخليج للبصريات. سعدنا بزيارتك ونتمنى أن تكون تجربتك معنا مميزة، نحن دائماً بخدمتك! 👓`);
        }

        var container = $('#contactPhonesContainer');
        container.empty();

        var primaryLink = generateWaLink(d.primaryPhone, waMsg);
        var phonesHtml = `<div class="d-flex justify-content-between align-items-center bg-light p-3 rounded-3 mb-3 border flex-wrap gap-2"><div class="fw-bold" style="direction:ltr; font-size:1.1rem;">${d.primaryPhone} <span class="badge bg-secondary ms-1 fs-6">أساسي</span></div><a href="${primaryLink}" target="_blank" class="btn btn-success rounded-3 px-4 d-flex align-items-center gap-2" style="text-decoration: none;"><i class="fa-brands fa-whatsapp fs-5"></i> <span>مراسلة</span></a></div>`;

        if (d.secondaryPhone) {
        var secondaryLink = generateWaLink(d.secondaryPhone, waMsg);
        var note = d.secondaryPhoneOwner ? d.secondaryPhoneOwner : 'احتياطي';
        phonesHtml += `<div class="d-flex justify-content-between align-items-center bg-light p-3 rounded-3 border-start border-3 border-success mb-3 flex-wrap gap-2"><div class="fw-bold" style="direction:ltr; font-size:1.1rem;">${d.secondaryPhone} <span class="badge bg-white text-dark border ms-1 fs-6">${note}</span></div><a href="${secondaryLink}" target="_blank" class="btn btn-outline-success rounded-3 bg-white px-4 d-flex align-items-center gap-2" style="text-decoration: none;"><i class="fa-brands fa-whatsapp fs-5"></i> <span>مراسلة</span></a></div>`;
        }
        container.html(phonesHtml);
        }

        // ربط تغيير الخيار بتحديث الروابط مباشرة
        $('input[name="msgType"]').off('change').on('change', updateLinks);

        // إعادة تعيين الخيار الافتراضي للتذكير عند فتح المودال وبناء الأزرار
        $('#msgReminder').prop('checked', true);
        updateLinks();

        // كود زر تأكيد التواصل
        var btnMark = $('#btnMarkContacted');
        if(d.isReminderSent) {
        btnMark.attr('style', 'background-color: #198754 !important; color: #ffffff !important; border: none !important;');
        btnMark.html('<i class="fa-solid fa-check me-2"></i> <span>تم التواصل مسبقاً</span>');
        btnMark.prop('disabled', true);
        } else {
        btnMark.attr('style', 'background-color: #f1f5f9 !important; color: #475569 !important; border: 1px solid #cbd5e1 !important;');
        btnMark.html('<i class="fa-solid fa-check-double me-2"></i> <span>تأكيد إتمام التواصل</span>');
        btnMark.prop('disabled', false);

        // التعديل: هنا تم إضافة سؤال تجديد الموعد
        btnMark.off('click').on('click', function() {
        $('#contactModal').modal('hide');

        Swal.fire({
        title: 'تم التواصل بنجاح 👏',
        text: 'هل ترغب بجدولة موعد تذكير جديد لهذا العميل بعد 6 أشهر من اليوم؟',
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#16a34a',
        cancelButtonColor: '#64748b',
        confirmButtonText: 'نعم، ذكّرني بعد 6 أشهر ⏱️',
        cancelButtonText: 'لا، فقط أخفِ التنبيه ✖️'
        }).then((result) => {
        let renew = result.isConfirmed;

        Swal.fire({ title: 'جاري الحفظ...', allowOutsideClick: false, didOpen: () => { Swal.showLoading() } });

        $.post('/ExaminationsController1/MarkAsContacted', { id: d.examId, renewForSixMonths: renew })
        .done(function (markRes) {
        if (markRes.success) {
        let toastMsg = renew ? 'تم إخفاء التنبيه وجدولة موعد جديد بعد 6 أشهر' : 'تم إخفاء التنبيه بنجاح';
        Swal.fire({ toast: true, position: 'bottom-end', icon: 'success', title: toastMsg, showConfirmButton: false, timer: 4000 });

        examsTable.ajax.reload(null, false);
        if(typeof loadSmartNotifications === "function") { loadSmartNotifications(); }
        } else {
        Swal.fire('خطأ', 'لم يتم الحفظ.', 'error');
        }
        })
        .fail(function() { Swal.fire('خطأ!', 'فصل الاتصال بالسيرفر.', 'error'); });
        });
        });
        }
        $('#contactModal').modal('show');
        } else { Swal.fire('خطأ', res.message, 'error'); }
        }).fail(function() { Swal.fire('خطأ!', 'فصل الاتصال بالسيرفر.', 'error'); });
        }
        function openExamModal() {
        $('#examForm')[0].reset(); $('#examForm').removeClass('was-validated');
        $('#examId').val(0); $('#PatientId').val(null).trigger('change'); resetUploadBox();
        $('#quickAddPatientWrapper').show();
        $('#modalTitle').text('إضافة فحص طبي جديد'); $('#examModal').modal('show');
        setTimeout(() => { $('#PatientId').select2('open'); }, 300);
        }

        function openQuickPatientModal() {
        $('#quickPatientForm')[0].reset();
        $('#quickPatientForm').removeClass('was-validated');
        $('#quickPatientModal').modal('show');
        setTimeout(() => { $('#qpFirstName').focus(); }, 300);
        }

        function saveQuickPatient() {
        var form = $('#quickPatientForm');
        if (!form[0].checkValidity()) {
        form.addClass('was-validated');
        return;
        }
        var btn = $('#btnSaveQuickPatient');
        var originalText = btn.text();
        btn.prop('disabled', true).html('<i class="fa-solid fa-spinner fa-spin"></i>');

        $.post('/ExaminationsController1/CreatePatientQuickly', form.serialize())
        .done(function (res) {
        if (res.success) {
        $('#quickPatientModal').modal('hide');
        Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: res.message, showConfirmButton: false, timer: 2000 });
        var newOption = new Option(res.patientName, res.patientId, true, true);
        $('#PatientId').append(newOption).trigger('change');
        $('#NextExamDate').focus();
        } else {
        Swal.fire('خطأ', res.message, 'error');
        }
        })
        .fail(function() { Swal.fire('خطأ', 'فشل الاتصال بالسيرفر.', 'error'); })
        .always(function() { btn.prop('disabled', false).text(originalText); });
        }

        function editExam(id, encodedName) {
        Swal.fire({ title: 'جاري جلب الملف...', allowOutsideClick: false, didOpen: () => { Swal.showLoading() } });
        $.get('/ExaminationsController1/GetExamById', { id: id })
        .done(function (res) {
        Swal.close();
        if (res.success) {
        var data = res.data;
        $('#examForm')[0].reset(); $('#examForm').removeClass('was-validated'); resetUploadBox();
        $('#examId').val(data.id);
        var pName = decodeURIComponent(encodedName);
        var newOption = new Option(pName, data.patientId, true, true);
        $('#PatientId').append(newOption).trigger('change');

        $('#quickAddPatientWrapper').hide();

        if(data.nextExamDate) { $('#NextExamDate').val(data.nextExamDate.substring(0, 10)); } else { $('#NextExamDate').val(''); }

        $('#ODSph').val(data.odSph); $('#ODCyl').val(data.odCyl); $('#ODAxis').val(data.odAxis); $('#ODAdd').val(data.odAdd);
        $('#ODVA').val(data.odva ?? data.odVa ?? data.odVA);

        $('#OSSph').val(data.osSph); $('#OSCyl').val(data.osCyl); $('#OSAxis').val(data.osAxis); $('#OSAdd').val(data.osAdd);
        $('#OSVA').val(data.osva ?? data.osVa ?? data.osVA);

        $('#IPD').val(data.ipd); $('#Remarks').val(data.remarks); $('#PurchaseNotes').val(data.purchaseNotes); $('#ExaminerName').val(data.examinerName);

        if(data.glassImagePath) {
        $('#uploadText span').text('يوجد صورة محفوظة (تغيير)');
        $('#uploadText i').removeClass('fa-camera text-muted').addClass('fa-check text-success');
        $('#uploadWrapper').css('border-color', '#22c55e');
        }
        $('#modalTitle').text('تعديل بيانات الفحص'); $('#examModal').modal('show');
        } else { Swal.fire('خطأ!', res.message, 'error'); }
        }).fail(function() { Swal.fire('خطأ!', 'لا يمكن الاتصال بالخادم لجلب البيانات.', 'error'); });
        }

        function saveExam() {
        var form = $('#examForm')[0];
        if (!form.checkValidity()) {
        $('#examForm').addClass('was-validated');
        Swal.fire({ icon: 'warning', title: 'بيانات ناقصة', text: 'يرجى اختيار العميل وتحديد الموعد القادم.', confirmButtonColor: '#d33' });
        return;
        }
        $('#btnSaveExam').prop('disabled', true); $('#btnSaveText').text('جاري الحفظ...'); $('#btnSaveSpinner').removeClass('d-none');
        var formData = new FormData(form); var id = $('#examId').val();
        var url = id == 0 ? '/ExaminationsController1/Create' : '/ExaminationsController1/Edit';
        $.ajax({
        url: url, type: 'POST', data: formData, processData: false, contentType: false,
        success: function (res) {
        if (res.success) {
        $('#examModal').modal('hide');
        Swal.fire({ icon: 'success', title: 'تمت العملية!', text: res.message, confirmButtonColor: 'var(--brand-color)', timer: 2000, showConfirmButton: false });
        examsTable.ajax.reload(null, false);
        if(typeof loadSmartNotifications === "function") { loadSmartNotifications(); }
        } else { Swal.fire('تنبيه', res.message, 'error'); }
        },
        error: function () { Swal.fire('خطأ!', 'حدثت مشكلة في الاتصال.', 'error'); },
        complete: function () { $('#btnSaveExam').prop('disabled', false); $('#btnSaveText').text('حفظ الفحص'); $('#btnSaveSpinner').addClass('d-none'); }
        });
        }

        function deleteExam(id) {
        Swal.fire({
        title: 'حذف الفحص؟', text: "لا يمكن التراجع!", icon: 'warning',
        showCancelButton: true, confirmButtonColor: '#ef4444', cancelButtonColor: '#828c9b',
        confirmButtonText: 'نعم، احذف', cancelButtonText: 'تراجع', reverseButtons: true
        }).then((result) => {
        if (result.isConfirmed) {
        Swal.fire({ title: 'جاري الحذف...', allowOutsideClick: false, didOpen: () => { Swal.showLoading() } });
        var token = $('input[name="__RequestVerificationToken"]').val();
        $.post('/ExaminationsController1/Delete', { id: id, __RequestVerificationToken: token })
        .done(function (res) {
        Swal.close();
        if (res.success) {
        Swal.fire({ icon: 'success', title: 'تم الحذف!', text: res.message, timer: 1500, showConfirmButton: false });
        examsTable.ajax.reload(null, false);
        if(typeof loadSmartNotifications === "function") { loadSmartNotifications(); }
        } else { Swal.fire('خطأ!', res.message, 'error'); }
        }).fail(function(xhr) {
        if(xhr.status === 403) { Swal.fire('مرفوض!', 'ليس لديك صلاحية للحذف.', 'error'); }
        else { Swal.fire('خطأ!', 'فصل الاتصال بالسيرفر.', 'error'); }
        });
        }
        });
        }

        function printExam(id, encodedName, phone) {
        var patientName = decodeURIComponent(encodedName);
        Swal.fire({ title: 'تجهيز الوصفة...', allowOutsideClick: false, didOpen: () => { Swal.showLoading() } });
        $.get('/ExaminationsController1/GetExamById', { id: id })
        .done(function (res) {
        Swal.close();
        if (res.success) {
        var d = res.data;
        var examDate = new Date(d.examDate).toLocaleDateString('ar-JO');
        const checkVal = (val) => (val === null || val === undefined || val === '') ? '<span class="text-muted small fw-normal">غير موجود</span>' : val;
        $('#printPatientName').text(patientName); $('#printExamDate').text(examDate);

        $('#p_odSph').html(checkVal(d.odSph)); $('#p_odCyl').html(checkVal(d.odCyl)); $('#p_odAxis').html(checkVal(d.odAxis)); $('#p_odAdd').html(checkVal(d.odAdd));
        $('#p_odVA').html(checkVal(d.odva ?? d.odVa ?? d.odVA));

        $('#p_osSph').html(checkVal(d.osSph)); $('#p_osCyl').html(checkVal(d.osCyl)); $('#p_osAxis').html(checkVal(d.osAxis)); $('#p_osAdd').html(checkVal(d.osAdd));
        $('#p_osVA').html(checkVal(d.osva ?? d.osVa ?? d.osVA));

        $('#printIPD').html(checkVal(d.ipd)); $('#printExaminer').html(checkVal(d.examinerName));

        var allRemarks = "";
        if(d.remarks) allRemarks += d.remarks;
        if(d.purchaseNotes) allRemarks += (allRemarks ? " | " : "") + d.purchaseNotes;

        var formattedRemarks = allRemarks.replace(/\n/g, '<br>');
        $('#printRemarks').html(checkVal(formattedRemarks));

        $('#btnPrintAction').off('click').on('click', function() {
        var cleanName = patientName.replace(/\s+/g, '_'); var newTitle = `وصفة_طبية_${cleanName}_${phone}`;
        var printContents = document.getElementById('printArea').innerHTML;
        var printWindow = window.open('', '_blank', 'width=900,height=700');
        var htmlTemplate = `
        <html dir="rtl" lang="ar">
        <head>
        <title>${newTitle}</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
        <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">
        <style>
        body { font-family: 'Cairo', sans-serif; background: #fff; padding: 20px; color: #1e293b; }
        .prescription-card { max-width: 800px; margin: auto; border: 2px solid #eaedf2; border-radius: 12px; padding: 2rem; }
        .prescription-header { text-align: center; border-bottom: 2px dashed #e2e8f0; padding-bottom: 1.5rem; margin-bottom: 1.5rem; }
        h2 { color: #7a1c4b; font-weight: bold; margin-bottom: 5px; font-size: 1.8rem; }
        .prescription-table { width: 100%; text-align: center; direction: ltr; border-collapse: collapse; margin-bottom: 1.5rem; }
        .prescription-table th { background-color: #f8fafc; padding: 12px; border: 1px solid #e2e8f0; font-weight: 700; color: #475569; font-size: 0.9rem; }
        .prescription-table td { padding: 12px; border: 1px solid #e2e8f0; font-weight: 700; color: #1e293b; font-size: 1.05rem; }
        .eye-label { background-color: #f1f5f9 !important; font-weight: 800 !important; font-size: 0.9rem !important; }
        .prescription-info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; background: #f8fafc; padding: 1.5rem; border-radius: 10px; margin-bottom: 15px; border: 1px solid #eaedf2; text-align: right; }
        .info-label { font-size: 0.85rem; color: #64748b; display: block; margin-bottom: 6px; font-weight: 600; }
        .info-value { font-weight: 700; color: #1e293b; font-size: 1.05rem; }
        .text-danger { color: #dc3545 !important; }
        .text-primary { color: #0d6efd !important; }
        .text-muted { color: #6c757d !important; }
        .text-end { text-align: left !important; }
        @@media print { body { -webkit-print-color-adjust: exact; print-color-adjust: exact; } }
        </style>
        </head>
        <body><div class="prescription-card">${printContents}</div><script>window.onload = function() { setTimeout(function() { window.print(); window.close(); }, 500); }<\/script></body></html>`;
        printWindow.document.write(htmlTemplate); printWindow.document.close();
        });
        $('#printModal').modal('show');
        } else { Swal.fire('خطأ', res.message, 'error'); }
        }).fail(function() { Swal.fire('خطأ!', 'فصل الاتصال بالسيرفر.', 'error'); });
        }
    </script>
}
