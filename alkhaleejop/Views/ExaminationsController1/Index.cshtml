@{
    ViewData["Title"] = "الفحوصات والقياسات";
}

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
<link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap5.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

<style>
    .page-header-action {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
        flex-wrap: wrap;
        gap: 15px;
    }

    .card-custom {
        background: #ffffff;
        border: none;
        border-radius: 16px;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.03);
        padding: 2rem;
        transition: all 0.3s ease;
    }

    #examsTable {
        border-collapse: separate;
        border-spacing: 0;
        width: 100% !important;
    }

        #examsTable thead th {
            background-color: #f8f9fc;
            color: #6c757d;
            font-weight: 700;
            font-size: 0.85rem;
            padding: 1.2rem 1rem;
            border-bottom: 2px solid #eaedf2;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-top: none;
            white-space: nowrap;
        }

        #examsTable tbody td {
            padding: 1.2rem 1rem;
            vertical-align: middle;
            border-bottom: 1px solid #f0f2f5;
            font-size: 0.95rem;
            color: #495057;
        }

        #examsTable tbody tr:hover td {
            background-color: #fdfdfd;
        }

    .actions-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .btn-action {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        border: none;
        font-size: 0.95rem;
        flex-shrink: 0;
    }

        .btn-action:hover {
            transform: translateY(-3px);
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        }

    .btn-view {
        background-color: #f3f0ff;
        color: #8b5cf6;
    }

        .btn-view:hover {
            background-color: #8b5cf6;
            color: #fff;
        }

    .btn-edit {
        background-color: #f0f4ff;
        color: #3b82f6;
    }

        .btn-edit:hover {
            background-color: #3b82f6;
            color: #fff;
        }

    .btn-delete {
        background-color: #fee2e2;
        color: #ef4444;
    }

        .btn-delete:hover {
            background-color: #ef4444;
            color: #fff;
        }

    .btn-contact {
        background-color: #eafbf1;
        color: #22c55e;
    }

        .btn-contact:hover {
            background-color: #22c55e;
            color: #fff;
        }

    .btn-image {
        background-color: #fff7ed;
        color: #ea580c;
        border: 1px solid #ffedd5;
    }

        .btn-image:hover {
            background-color: #ea580c;
            color: #fff;
        }

    .top-controls-wrapper {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
        gap: 15px;
    }

    div.dataTables_wrapper div.dataTables_length {
        margin: 0;
    }

        div.dataTables_wrapper div.dataTables_length label {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: #6c757d;
            font-weight: 600;
            margin-bottom: 0;
        }

        div.dataTables_wrapper div.dataTables_length select {
            border-radius: 8px;
            border: 1px solid #eaedf2;
            padding: 0.4rem 1.8rem 0.4rem 0.8rem;
            outline: none;
            color: #495057;
            box-shadow: none;
        }

            div.dataTables_wrapper div.dataTables_length select:focus {
                border-color: var(--brand-color);
            }

    div.dataTables_wrapper div.dataTables_filter {
        margin: 0;
    }

        div.dataTables_wrapper div.dataTables_filter input {
            border-radius: 10px;
            border: 2px solid #eaedf2;
            padding: 0.6rem 1.2rem;
            outline: none;
            box-shadow: none;
            transition: border-color 0.3s ease;
            width: 250px;
            margin-right: 10px;
        }

            div.dataTables_wrapper div.dataTables_filter input:focus {
                border-color: var(--brand-color);
            }

    div.dt-buttons {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

        div.dt-buttons .btn {
            background-color: #ffffff !important;
            border: 1px solid #eaedf2 !important;
            color: #495057 !important;
            border-radius: 10px !important;
            font-weight: 600 !important;
            padding: 0.5rem 1.2rem !important;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.02) !important;
            transition: all 0.2s ease !important;
        }

            div.dt-buttons .btn:hover {
                background-color: #f8f9fc !important;
                border-color: #d1d5db !important;
                transform: translateY(-2px);
            }

    .eye-card {
        background: #fdfdfe;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 1.5rem;
        transition: border-color 0.3s;
        margin-bottom: 1rem;
    }

        .eye-card:focus-within {
            border-color: var(--brand-color);
            box-shadow: 0 0 0 4px rgba(122, 28, 75, 0.05);
        }

    .eye-title {
        font-weight: 800;
        font-size: 1.05rem;
        margin-bottom: 1.2rem;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .eye-right-title {
        color: #dc2626;
    }

    .eye-left-title {
        color: #2563eb;
    }

    .opt-input {
        direction: ltr;
        text-align: center;
        font-weight: 700;
        font-size: 1.1rem;
        letter-spacing: 1px;
        color: #1e293b;
    }

        .opt-input:focus {
            background-color: #f8fafc;
        }

    .select2-container .select2-selection--single {
        height: calc(3.5rem + 2px);
        padding: 0.75rem;
        border-radius: 10px;
        border: 1px solid #dee2e6;
    }

    .select2-container--default .select2-selection--single .select2-selection__arrow {
        top: 15px;
        right: 10px;
    }

    .select2-selection__rendered {
        font-weight: 600;
        color: #334155 !important;
    }

    .modern-input {
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 0.7rem 1rem;
        transition: all 0.3s;
        color: #1e293b;
        font-weight: 600;
        width: 100%;
    }

        .modern-input:focus {
            background-color: #ffffff;
            border-color: var(--brand-color);
            box-shadow: 0 0 0 3px rgba(122, 28, 75, 0.1);
        }

    textarea.modern-input {
        resize: vertical;
        min-height: 90px;
        line-height: 1.6;
    }

    .modern-label {
        font-weight: 700;
        color: #334155;
        font-size: 0.95rem;
        margin-bottom: 0.6rem;
        display: flex;
        align-items: center;
        justify-content: flex-start;
        gap: 8px;
        text-align: right;
    }

        .modern-label i {
            color: #64748b;
        }

    .btn-quick-add {
        background: #f8fafc;
        border: 1px solid #cbd5e1;
        color: var(--brand-color);
        font-weight: 700;
        border-radius: 10px;
        padding: 0.7rem 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        transition: all 0.2s;
        height: calc(3.5rem + 2px);
        width: 100%;
    }

        .btn-quick-add:hover {
            background: var(--brand-color);
            color: #fff;
            border-color: var(--brand-color);
        }

    .smart-date-btn {
        background-color: #f8fafc;
        border: 1px solid #cbd5e1;
        color: #475569;
        font-weight: 700;
        font-size: 0.85rem;
        transition: all 0.2s;
        flex: 1;
        text-align: center;
    }

        .smart-date-btn:hover {
            background-color: var(--brand-color);
            color: #fff;
            border-color: var(--brand-color);
        }

    .file-upload-wrapper {
        position: relative;
        width: 100%;
        height: 60px;
        border: 2px dashed #cbd5e1;
        border-radius: 10px;
        background-color: #f8fafc;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        transition: all 0.3s ease;
        cursor: pointer;
    }

        .file-upload-wrapper:hover {
            border-color: var(--brand-color);
            background-color: #fdfafb;
        }

    .file-upload-input {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        cursor: pointer;
    }

    .file-upload-text {
        font-weight: 600;
        color: #64748b;
        display: flex;
        align-items: center;
        gap: 8px;
        z-index: 1;
        pointer-events: none;
    }

    .prescription-card {
        background: #fff;
        border: 2px solid #eaedf2;
        border-radius: 12px;
        padding: 2rem;
        margin-top: 1rem;
        width: 100%;
        overflow-x: auto;
    }

    .prescription-header {
        text-align: center;
        border-bottom: 2px dashed #e2e8f0;
        padding-bottom: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .prescription-logo {
        color: var(--brand-color);
        font-size: 2.5rem;
        margin-bottom: 0.5rem;
    }

    .prescription-table {
        width: 100%;
        text-align: center;
        direction: ltr;
        border-collapse: collapse;
        margin-bottom: 1.5rem;
        min-width: 500px;
    }

        .prescription-table th {
            background-color: #f8fafc;
            padding: 12px;
            border: 1px solid #e2e8f0;
            font-weight: 700;
            color: #475569;
            font-size: 0.9rem;
        }

        .prescription-table td {
            padding: 12px;
            border: 1px solid #e2e8f0;
            font-weight: 700;
            color: #1e293b;
            font-size: 1.05rem;
        }

    .eye-label {
        background-color: #f1f5f9 !important;
        font-weight: 800 !important;
        font-size: 0.9rem !important;
    }

    .prescription-info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
        background: #f8fafc;
        padding: 1.5rem;
        border-radius: 10px;
        margin-bottom: 15px;
        border: 1px solid #eaedf2;
    }

    .info-label {
        font-size: 0.85rem;
        color: #64748b;
        display: block;
        margin-bottom: 6px;
        font-weight: 600;
    }

    .info-value {
        font-weight: 700;
        color: #1e293b;
        font-size: 1.05rem;
        white-space: pre-line;
    }


    @@media (max-width: 991px) {
        .top-controls-wrapper {
            flex-direction: column;
            align-items: stretch;
            gap: 15px;
        }

        .left-controls {
            flex-direction: column;
            align-items: stretch !important;
            gap: 10px !important;
            width: 100%;
        }

        div.dt-buttons {
            justify-content: center;
            width: 100%;
        }

            div.dt-buttons .btn {
                flex: 1;
                justify-content: center;
                padding: 0.6rem;
                font-size: 0.9rem;
            }

        div.dataTables_wrapper div.dataTables_filter {
            text-align: right;
            width: 100%;
        }

            div.dataTables_wrapper div.dataTables_filter input {
                width: 100%;
                margin: 0;
                margin-top: 10px;
            }

        div.dataTables_wrapper div.dataTables_length label {
            justify-content: space-between;
            width: 100%;
        }

        .prescription-info-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 576px) {
        .page-header-action {
            flex-direction: column;
            align-items: flex-start;
        }

            .page-header-action button {
                width: 100%;
                justify-content: center;
            }

        .card-custom {
            padding: 1rem;
        }

        .eye-card {
            padding: 1rem 0.75rem;
        }

        .form-floating > label {
            font-size: 0.75rem;
            padding: 1rem 0.5rem;
        }

        .opt-input {
            font-size: 0.95rem;
            padding-top: 1.6rem !important;
            padding-bottom: 0.4rem !important;
        }

        .smart-date-btn {
            font-size: 0.75rem;
            padding: 0.3rem;
        }

        .btn-action {
            width: 32px;
            height: 32px;
            font-size: 0.85rem;
        }

        .actions-wrapper {
            justify-content: flex-start;
        }

        .prescription-card {
            padding: 1rem;
        }

        .modal-body {
            padding: 1rem !important;
        }
    }
</style>

<div class="page-header-action">
    <div>
        <h3 class="fw-bold mb-1" style="color: var(--text-main);">سجل الفحوصات الطبية</h3>
        <span class="text-muted" style="font-size: 0.9rem;">إدارة دقيقة لقياسات النظر والوصفات</span>
    </div>
    <button class="btn btn-primary px-4 py-2.5 rounded-3 fw-bold shadow-sm d-flex align-items-center" style="background-color: var(--brand-color); border-color: var(--brand-color);" onclick="openExamModal()">
        <i class="fa-solid fa-plus me-2"></i> إضافة فحص جديد
    </button>
</div>

<div class="card-custom">
    <table id="examsTable" class="table dt-responsive nowrap w-100">
        <thead>
            <tr>
                <th>التاريخ والوقت</th>
                <th>اسم العميل</th>
                <th>أرقام الهواتف</th>
                <th>الموعد القادم</th>
                <th class="text-center">الإجراءات</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>

<div class="modal fade" id="examModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-bottom-0 pb-0 mt-3">
                <h5 class="modal-title fw-bold px-3" id="modalTitle" style="color: var(--brand-color);">إضافة فحص طبي</h5>
                <button type="button" class="btn-close me-3" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="examForm" class="needs-validation" novalidate enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="examId" name="Id" value="0" />

                    <div class="row g-3 mb-4 align-items-start bg-light p-3 rounded-4 mx-0 border">
                        <div class="col-lg-5 col-md-12 col-sm-12">
                            <label class="fw-bold text-dark mb-2">العميل <span class="text-danger">*</span></label>
                            <div class="d-flex gap-2">
                                <div style="flex-grow: 1;">
                                    <select class="form-control" id="PatientId" name="PatientId" style="width: 100%;" required tabindex="1"></select>
                                    <div class="invalid-feedback">يرجى اختيار العميل أولاً.</div>
                                </div>
                                <div id="quickAddPatientWrapper">
                                    <button type="button" class="btn-quick-add" onclick="openQuickPatientModal()" title="إضافة عميل جديد" tabindex="-1">
                                        <i class="fa-solid fa-user-plus"></i> <span class="d-none d-sm-inline">جديد</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6 col-sm-12">
                            <label class="fw-bold text-dark mb-2">الموعد القادم <span class="text-danger">*</span></label>
                            <input type="date" class="form-control fw-bold text-primary modern-input" id="NextExamDate" name="NextExamDate" required tabindex="2">
                            <div class="d-flex justify-content-between mt-2 gap-1">
                                <button type="button" class="btn smart-date-btn rounded-2" tabindex="-1" onclick="setSmartDate(2)">شهرين</button>
                                <button type="button" class="btn smart-date-btn rounded-2" tabindex="-1" onclick="setSmartDate(3)">3 أشهر</button>
                                <button type="button" class="btn smart-date-btn rounded-2" tabindex="-1" onclick="setSmartDate(6)">6 أشهر</button>
                            </div>
                            <div class="invalid-feedback">يرجى تحديد تاريخ الفحص.</div>
                        </div>
                        <div class="col-lg-4 col-md-6 col-sm-12">
                            <label class="fw-bold text-dark mb-2"><i class="fa-solid fa-camera"></i> صورة النظارة / الوصفة</label>
                            <div class="file-upload-wrapper" id="uploadWrapper">
                                <input type="file" id="ImageFile" name="ImageFile" class="file-upload-input" accept="image/*" capture="environment" onchange="previewFileName(this)" tabindex="3">
                                <div class="file-upload-text" id="uploadText">
                                    <i class="fa-solid fa-camera fs-5"></i>
                                    <span>التقط أو ارفع صورة</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-lg-12 mb-4">
                            <div class="eye-card">
                                <div class="eye-title eye-right-title">
                                    <i class="fa-solid fa-eye"></i> العين اليمنى (Right - O.D)
                                </div>
                                <div class="row g-2">
                                    <div class="col-4">
                                        <div class="input-group" style="direction: ltr;">
                                            <button class="btn btn-light border px-1 px-sm-2 fw-bold" type="button" tabindex="-1" onclick="toggleSign('ODAxis', '-')">-</button>
                                            <div class="form-floating" style="flex: 1;">
                                                <input type="text" inputmode="decimal" class="form-control opt-input rounded-0" id="ODAxis" name="ODAxis" placeholder="AXIS" oninput="this.value = this.value.replace(/[^0-9\.\+\-]/g, '')" tabindex="6">
                                                <label>AXIS</label>
                                            </div>
                                            <button class="btn btn-light border px-1 px-sm-2 fw-bold" type="button" tabindex="-1" onclick="toggleSign('ODAxis', '+')">+</button>
                                        </div>
                                    </div>

                                    <div class="col-4">
                                        <div class="input-group" style="direction: ltr;">
                                            <button class="btn btn-light border px-1 px-sm-2 fw-bold" type="button" tabindex="-1" onclick="toggleSign('ODCyl', '-')">-</button>
                                            <div class="form-floating" style="flex: 1;">
                                                <input type="text" inputmode="decimal" class="form-control opt-input rounded-0" id="ODCyl" name="ODCyl" placeholder="CYL" oninput="this.value = this.value.replace(/[^0-9\.\+\-]/g, '')" tabindex="5">
                                                <label>CYL</label>
                                            </div>
                                            <button class="btn btn-light border px-1 px-sm-2 fw-bold" type="button" tabindex="-1" onclick="toggleSign('ODCyl', '+')">+</button>
                                        </div>
                                    </div>

                                    <div class="col-4">
                                        <div class="input-group" style="direction: ltr;">
                                            <button class="btn btn-light border px-1 px-sm-2 fw-bold" type="button" tabindex="-1" onclick="toggleSign('ODSph', '-')">-</button>
                                            <div class="form-floating" style="flex: 1;">
                                                <input type="text" inputmode="decimal" class="form-control opt-input rounded-0" id="ODSph" name="ODSph" placeholder="SPH" oninput="this.value = this.value.replace(/[^0-9\.\+\-]/g, '')" tabindex="4">
                                                <label>SPH</label>
                                            </div>
                                            <button class="btn btn-light border px-1 px-sm-2 fw-bold" type="button" tabindex="-1" onclick="toggleSign('ODSph', '+')">+</button>
                                        </div>
                                    </div>

                                    <div class="col-6 mt-3">
                                        <div class="form-floating" style="direction: ltr;">
                                            <input type="text" class="form-control opt-input" id="ODVA" name="ODVA" placeholder="VA" tabindex="7">
                                            <label>V.A</label>
                                        </div>
                                    </div>
                                    <div class="col-6 mt-3">
                                        <div class="input-group" style="direction: ltr;">
                                            <button class="btn btn-light border px-2 px-sm-3 fw-bold" type="button" tabindex="-1" onclick="toggleSign('ODAdd', '-')">-</button>
                                            <div class="form-floating" style="flex: 1;">
                                                <input type="text" inputmode="decimal" class="form-control opt-input rounded-0" id="ODAdd" name="ODAdd" placeholder="ADD" oninput="this.value = this.value.replace(/[^0-9\.\+\-]/g, '')" tabindex="8">
                                                <label>ADD</label>
                                            </div>
                                            <button class="btn btn-light border px-2 px-sm-3 fw-bold" type="button" tabindex="-1" onclick="toggleSign('ODAdd', '+')">+</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- العين اليسرى -->
                        <div class="col-lg-12 mb-2">
                            <div class="eye-card">
                                <div class="eye-title eye-left-title">
                                    <i class="fa-solid fa-eye"></i> العين اليسرى (Left - O.S)
                                </div>
                                <div class="row g-2">
                                    <div class="col-4">
                                        <div class="input-group" style="direction: ltr;">
                                            <button class="btn btn-light border px-1 px-sm-2 fw-bold" type="button" tabindex="-1" onclick="toggleSign('OSAxis', '-')">-</button>
                                            <div class="form-floating" style="flex: 1;">
                                                <input type="text" inputmode="decimal" class="form-control opt-input rounded-0" id="OSAxis" name="OSAxis" placeholder="AXIS" oninput="this.value = this.value.replace(/[^0-9\.\+\-]/g, '')" tabindex="11">
                                                <label>AXIS</label>
                                            </div>
                                            <button class="btn btn-light border px-1 px-sm-2 fw-bold" type="button" tabindex="-1" onclick="toggleSign('OSAxis', '+')">+</button>
                                        </div>
                                    </div>

                                    <div class="col-4">
                                        <div class="input-group" style="direction: ltr;">
                                            <button class="btn btn-light border px-1 px-sm-2 fw-bold" type="button" tabindex="-1" onclick="toggleSign('OSCyl', '-')">-</button>
                                            <div class="form-floating" style="flex: 1;">
                                                <input type="text" inputmode="decimal" class="form-control opt-input rounded-0" id="OSCyl" name="OSCyl" placeholder="CYL" oninput="this.value = this.value.replace(/[^0-9\.\+\-]/g, '')" tabindex="10">
                                                <label>CYL</label>
                                            </div>
                                            <button class="btn btn-light border px-1 px-sm-2 fw-bold" type="button" tabindex="-1" onclick="toggleSign('OSCyl', '+')">+</button>
                                        </div>
                                    </div>

                                    <div class="col-4">
                                        <div class="input-group" style="direction: ltr;">
                                            <button class="btn btn-light border px-1 px-sm-2 fw-bold" type="button" tabindex="-1" onclick="toggleSign('OSSph', '-')">-</button>
                                            <div class="form-floating" style="flex: 1;">
                                                <input type="text" inputmode="decimal" class="form-control opt-input rounded-0" id="OSSph" name="OSSph" placeholder="SPH" oninput="this.value = this.value.replace(/[^0-9\.\+\-]/g, '')" tabindex="9">
                                                <label>SPH</label>
                                            </div>
                                            <button class="btn btn-light border px-1 px-sm-2 fw-bold" type="button" tabindex="-1" onclick="toggleSign('OSSph', '+')">+</button>
                                        </div>
                                    </div>

                                    <div class="col-6 mt-3">
                                        <div class="form-floating" style="direction: ltr;">
                                            <input type="text" class="form-control opt-input" id="OSVA" name="OSVA" placeholder="VA" tabindex="12">
                                            <label>V.A</label>
                                        </div>
                                    </div>
                                    <div class="col-6 mt-3">
                                        <div class="input-group" style="direction: ltr;">
                                            <button class="btn btn-light border px-2 px-sm-3 fw-bold" type="button" tabindex="-1" onclick="toggleSign('OSAdd', '-')">-</button>
                                            <div class="form-floating" style="flex: 1;">
                                                <input type="text" inputmode="decimal" class="form-control opt-input rounded-0" id="OSAdd" name="OSAdd" placeholder="ADD" oninput="this.value = this.value.replace(/[^0-9\.\+\-]/g, '')" tabindex="13">
                                                <label>ADD</label>
                                            </div>
                                            <button class="btn btn-light border px-2 px-sm-3 fw-bold" type="button" tabindex="-1" onclick="toggleSign('OSAdd', '+')">+</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mt-2">
